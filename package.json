{
  "name": "content-analysis-app",
  "version": "1.0.0",
  "description": "Content Analysis Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build-backend": "pyinstaller --distpath ./backend-dist --workpath ./build-backend --clean backend.spec",
    "dist": "npm run build-backend && electron-builder --win",
    "dist-portable": "npm run build-backend && electron-builder --win portable",
    "dist-all": "npm run build-backend && electron-builder --win nsis --win portable",
    "pack": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.contentanalysis.app",
    "productName": "Content Analysis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/backend/",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null,
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true
}
